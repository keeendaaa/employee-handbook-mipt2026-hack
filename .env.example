# Local development only. Set a private alphanumeric password before starting.
POSTGRES_PASSWORD=replace_me_local_only
# For CLI outside Docker (export this variable explicitly; CLI does not load .env).
DATABASE_URL=postgresql://navigator:replace_me_local_only@127.0.0.1:5433/navigator

# HTTP demo: use 0.0.0.0 and port 80 on the VPS, loopback by default.
HTTP_BIND=127.0.0.1
HTTP_PORT=8000
LLM_MODEL=Qwen/Qwen3.8-27B
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
# Put the API key in secrets/llm_api_key (chmod 600); never commit it.

# With a host reverse proxy: keep HTTP_BIND=127.0.0.1 and HTTP_PORT=8000.
# Trust only the Docker bridge gateway used by that proxy, e.g. 172.18.0.1.
FORWARDED_ALLOW_IPS=127.0.0.1
